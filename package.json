{
  "name": "library-tracker-for-millennium",
  "version": "0.1.0",
  "description": "Automatic game progress tracking with achievement %, HowLongToBeat estimates, and Mastered/Completed/In Progress/Dropped tags for Millennium.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "millennium-ttc --build dev --target . --no-update",
    "build:release": "millennium-ttc --build prod --target . --no-update",
    "watch": "millennium-ttc --build dev --target . --no-update --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:backend": "lua tests/run.lua",
    "test": "npm run typecheck && npm run test:backend"
  },
  "dependencies": {
    "@steambrew/client": "^5.8.5"
  },
  "devDependencies": {
    "@steambrew/ttc": "^3.3.7",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/react-router": "5.1.20",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-icons": "^5.5.0",
    "typescript": "^5.6.3"
  }
}