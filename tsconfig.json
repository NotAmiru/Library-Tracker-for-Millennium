{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "millennium": [
        ".millennium/lsp/ts"
      ]
    },
    "typeRoots": [
      ".millennium/types",
      "node_modules/@types"
    ]
  },
  "include": [
    "frontend/**/*.ts",
    "frontend/**/*.tsx"
  ]
}